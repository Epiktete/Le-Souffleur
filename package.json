    "@types/node": "^24.13.3",
    "fake-indexeddb": "^6.2.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.18"
